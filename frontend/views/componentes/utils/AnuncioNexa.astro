---
const siteNexa = 'https://auroranexaa.netlify.app/';
const logoNexa = '/imagens/nexa/nexa-logo.webp';
---

<section class="h1-nexa-ad" aria-label="Publicidade da parceria entre H1 Produtora e NEXA">
  <div class="h1-nexa-ad__bar">
    <span>✧ COLABORAÇÃO</span>
    <span aria-hidden="true">H1 × NEXA</span>
  </div>

  <div class="h1-nexa-ad__body">
    <p class="h1-nexa-ad__kicker">PARCERIA EM DESTAQUE</p>

    <div class="h1-nexa-ad__logo">
      <img
        src={logoNexa}
        alt="NEXA"
        loading="lazy"
        decoding="async"
      />
    </div>

    <strong class="h1-nexa-ad__title">Em colaboração com a equipe NEXA</strong>

    <p class="h1-nexa-ad__description">
      Da cibersegurança à ciência e à saúde: uma corporação que expandiu
      sua atuação para os mais diversos setores.
    </p>

    <a
      class="h1-nexa-ad__link"
      href={siteNexa}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Conhecer o site da NEXA (abre em nova aba)"
    >
      <span>CONHECER A NEXA</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .h1-nexa-ad {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #725d9d;
    color: #f7eaff;
    background: linear-gradient(145deg, #332145, #1d1937 85%);
    box-shadow: inset 0 1px #ffffff18, 0 5px 17px #39314d2d;
  }

  .h1-nexa-ad__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .3rem;
    min-height: 32px;
    padding: .55rem .75rem;
    border-bottom: 1px solid #9981bc;
    background: linear-gradient(180deg, #e7c0f8, #b080d7 36%, #773ea6 53%, #56327e 100%);
    color: #fff;
    text-shadow: 0 1px #3f225e;
    font: 800 .67rem var(--font-mono, monospace);
    letter-spacing: .04em;
  }

  .h1-nexa-ad__bar span:last-child {
    font-size: .5rem;
    opacity: .85;
  }

  .h1-nexa-ad__body {
    display: grid;
    justify-items: stretch;
    gap: .65rem;
    padding: .85rem .75rem .9rem;
    background:
      radial-gradient(circle at 50% 20%, #87dbe71b, transparent 58%),
      linear-gradient(165deg, #302343, #171b32);
  }

  .h1-nexa-ad__kicker {
    margin: 0;
    color: #c6e8ee;
    font: 700 .55rem var(--font-mono, monospace);
    letter-spacing: .07em;
    text-align: center;
  }

  .h1-nexa-ad__logo {
    display: grid;
    place-items: center;
    min-height: 105px;
    padding: .65rem;
    border: 1px solid #9ad7e45c;
    background: radial-gradient(circle at 50% 35%, #5c758a48, #101725 75%);
    box-shadow: inset 0 0 20px #0409158c, 0 0 14px #a4e7fa16;
  }

  .h1-nexa-ad__logo img {
    display: block;
    width: 100%;
    max-width: 160px;
    max-height: 105px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 10px #e4f6ff44);
  }

  .h1-nexa-ad__title {
    color: #fff;
    font-size: .8rem;
    line-height: 1.4;
    text-align: center;
    text-wrap: balance;
  }

  .h1-nexa-ad__description {
    margin: 0;
    color: #d0c8de;
    font-size: .72rem;
    line-height: 1.55;
    text-align: center;
  }

  .h1-nexa-ad__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .4rem;
    min-height: 35px;
    padding: .55rem .65rem;
    border: 1px solid #b4eaf3;
    color: #183b53;
    background: linear-gradient(180deg, #f7fdff, #bcecf8 49%, #78bdd4 51%, #a3c5ec);
    box-shadow: inset 0 1px #fff, 0 3px 0 #467e9c;
    font: 800 .61rem var(--font-mono, monospace);
    letter-spacing: .025em;
    text-decoration: none;
    transition: filter 170ms ease, translate 170ms ease;
  }

  .h1-nexa-ad__link:hover {
    filter: brightness(1.08);
    translate: 0 -2px;
  }

  .h1-nexa-ad__link:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .h1-nexa-ad__link { transition: none; }
    .h1-nexa-ad__link:hover { translate: none; }
  }
</style>
