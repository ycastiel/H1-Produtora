{
  "name": "h1-produtora",
  "compatibility_date": "2026-10-20",
  "main": "./Worker.ts",
  "secrets": {
    "required": [
      "H1_LOGIN_CREDENTIALS",
      "H1_SESSION_KEY"
    ]
  },

"ratelimits": [
  {
    "name": "H1_LOGIN_LIMITER",
    "namespace_id": "2026111601",
    "simple": {
      "limit": 8,
      "period": 60
    }
  }
],

  "assets": {
    "directory": "../start/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/login*"
    ]
  },
  "previews": {}
}
